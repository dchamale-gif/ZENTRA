# Confiar en X-Forwarded-For solo cuando la petición viene de una red privada
# (por ejemplo nginx del mismo servidor en modo proxy); así el backend ve la IP real.
{
    servers {
        trusted_proxies static private_ranges
    }
}

# DOMAIN viene de .env (por ejemplo zentra.midominio.com).
# Con un dominio real Caddy obtiene y renueva solo el certificado HTTPS
# (Let's Encrypt) y redirige HTTP a HTTPS. Sin DOMAIN usa "localhost"
# con un certificado local, útil para probar en la propia máquina.
{$DOMAIN:localhost} {
    encode zstd gzip

    @api path /api/* /health
    handle @api {
        reverse_proxy backend:3011
    }

    handle {
        root * /srv

        # Los HTML siempre se revalidan para que los cambios lleguen al instante;
        # CSS, JS e imágenes se guardan en caché una hora.
        @html path / *.html
        header @html Cache-Control "no-cache"
        @assets path /css/* /js/* /img/* /data/* /vendor/*
        header @assets Cache-Control "public, max-age=3600"

        # La raíz abre el login; login.js redirige al panel si ya hay sesión.
        @root path /
        rewrite @root /login.html

        # Las rutas que no existen devuelven 404 en lugar de mostrar el panel.
        file_server
    }

    handle_errors {
        @notfound expression {err.status_code} == 404
        handle @notfound {
            root * /srv
            rewrite * /404.html
            file_server
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
}
