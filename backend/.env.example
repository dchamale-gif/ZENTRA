# ====================================
# DATABASE
# ====================================
DB_HOST=localhost
DB_PORT=5432
# En producción use un rol sin SUPERUSER ni BYPASSRLS para que el aislamiento RLS sea obligatorio.
DB_USER=zentra_app
DB_PASSWORD=password
DB_NAME=zentra

# ====================================
# SERVER
# ====================================
PORT=3011
NODE_ENV=development

# ====================================
# JWT
# ====================================
JWT_SECRET=tu_super_secreto_jwt_cambiar_en_produccion_minimo_32_caracteres
JWT_EXPIRATION=7d

# ====================================
# CUENTA DE SOPORTE (crear con npm run create:platform-admin)
# ====================================
PLATFORM_ADMIN_EMAIL=soporte@zentra.com
PLATFORM_ADMIN_PASSWORD=CAMBIAR_POR_UNA_PASSWORD_DE_12_O_MAS_CARACTERES
PLATFORM_ADMIN_NAME=Soporte Zentra

# ====================================
# CORS
# ====================================
CORS_ORIGIN=http://localhost:5500,http://localhost:3000,file://

# ====================================
# LOGGING
# ====================================
LOG_LEVEL=debug

# ====================================
# HTTPS / SSL
# ====================================
HTTPS_PORT=3011
USE_HTTPS=true
CERT_PATH=./certs/server.crt
KEY_PATH=./certs/server.key
