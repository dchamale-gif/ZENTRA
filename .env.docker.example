DOMAIN=zentra.example.com
POSTGRES_DB=zentra
POSTGRES_USER=zentra_owner
NODE_ENV=production
CORS_ORIGIN=https://zentra.example.com
JWT_EXPIRATION=8h
PLATFORM_ADMIN_EMAIL=soporte@zentra.example.com
PLATFORM_ADMIN_NAME=Soporte Zentra
# Visitas del sitio web (misma clave que ANALYTICS_API_KEY en WebBotEngine)
WEBSITE_ANALYTICS_URL=https://botenginecorp.com
WEBSITE_ANALYTICS_KEY=
# Bases de datos externas a las que las empresas pueden conectar su página web (Configuración →
# Integraciones), separadas por coma. Vacío = ninguna. Para una base en este mismo servidor, fuera
# de Docker, usa host.docker.internal. La llave de cifrado está en secrets/integrations_key.txt.
INTEGRATIONS_ALLOWED_HOSTS=
# Correos a clientes por Brevo: remitente verificado en Brevo. La clave va en secrets/email_api_key.txt.
EMAIL_FROM=
EMAIL_FROM_NAME="BotEngine ERP"
